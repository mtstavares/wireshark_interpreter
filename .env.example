PCAP_DATA_DIR=.data
PCAP_MAX_UPLOAD_BYTES=104857600
PCAP_LOG_LEVEL=INFO
PCAP_ANALYZER_TIMEOUT_SECONDS=300
PCAP_NORMALIZATION_TIMEOUT_SECONDS=900
PCAP_ANALYZER_MEMORY_LIMIT_MB=1024
PCAP_ANALYZER_CPU_LIMIT_SECONDS=240
PCAP_RETENTION_DAYS=30
PCAP_ZEEK_BINARY=zeek
# Alternativa isolada no Windows: docker://zeek/zeek:lts
PCAP_SURICATA_BINARY=suricata
PCAP_TSHARK_BINARY=tshark
# Arquivos opcionais da Sprint 7. Ausência mantém o enriquecimento offline básico.
PCAP_ASSET_CONTEXT_FILE=
PCAP_REPUTATION_FILE=
PCAP_ENRICHMENT_CATALOG_FILE=
# Validacao ativa permanece desabilitada sem uma politica explicita.
PCAP_VALIDATION_POLICY_FILE=
# Politica opcional para classificar logins observados como autorizados/nao autorizados.
PCAP_CREDENTIAL_POLICY_FILE=
# Configure ambos para exigir HTTP Basic em toda a interface/API, exceto /healthz.
PCAP_AUTH_USERNAME=
PCAP_AUTH_PASSWORD=
