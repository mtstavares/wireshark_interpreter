{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcap-security-analyzer.local/schemas/finding-1.0.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "analysis_id",
    "title",
    "category",
    "severity",
    "confidence",
    "assertion_status",
    "summary",
    "evidence",
    "mitigations",
    "mitre_attack",
    "detector_name",
    "detector_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "severity": {
      "enum": ["informational", "low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assertion_status": {
      "enum": [
        "observed",
        "inferred",
        "signature_match",
        "potential",
        "confirmed",
        "false_positive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "first_seen": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "last_seen": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_ip": {
      "oneOf": [
        { "type": "string", "format": "ipv4" },
        { "type": "string", "format": "ipv6" },
        { "type": "null" }
      ]
    },
    "destination_ip": {
      "oneOf": [
        { "type": "string", "format": "ipv4" },
        { "type": "string", "format": "ipv6" },
        { "type": "null" }
      ]
    },
    "destination_port": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 65535
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "mitigations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 10
    },
    "mitre_attack": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      },
      "uniqueItems": true
    },
    "cve_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
      },
      "uniqueItems": true
    },
    "detector_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "detector_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "source"],
      "properties": {
        "kind": {
          "enum": ["event", "flow", "packet", "alert", "log", "enrichment"]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "validation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 100 },
        "result": {
          "enum": ["not_run", "inconclusive", "supported", "confirmed", "rejected"]
        },
        "authorized": { "type": "boolean" },
        "notes": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  }
}
